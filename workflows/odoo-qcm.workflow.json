    {
      "id": "e91c2b2e-6eb0-5174-8bda-01ab6f6438d6",
      "name": "Read image (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        440,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendQuery": false,
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"model\": \"claude-sonnet-5-5\", \"max_tokens\": 2000, \"output_config\": {\"effort\": \"low\", \"format\": {\"type\": \"json_schema\", \"schema\": {\"type\": \"object\", \"properties\": {\"lisible\": {\"type\": \"boolean\"}, \"raison\": {\"type\": \"string\"}, \"question\": {\"type\": \"string\"}, \"choix\": {\"type\": \"array\", \"items\": {\"type\": \"string\"} }, \"plusieurs_reponses\": {\"type\": \"boolean\"} }, \"required\": [\"lisible\", \"raison\", \"question\", \"choix\", \"plusieurs_reponses\"], \"additionalProperties\": false} } }, \"system\": \"Tu lis des photos ou captures d'écran de questions de certification Odoo et tu les recopies fidèlement.\", \"messages\": [{\"role\": \"user\", \"content\": [{\"type\": \"image\", \"source\": {\"type\": \"base64\", \"media_type\": $json.mime, \"data\": $json.image} }, {\"type\": \"text\", \"text\": \"Cette image doit montrer une question à choix multiples de la certification Odoo. Ne réponds pas à la question : recopie-la.\\n- \\\"question\\\" : l'énoncé mot pour mot, dans sa langue d'origine (souvent l'anglais), sans numéro de question.\\n- \\\"choix\\\" : chaque choix mot pour mot, dans l'ordre d'affichage, sans lettre, puce ni case.\\n- \\\"plusieurs_reponses\\\" : vrai seulement si l'écran indique que plusieurs réponses sont attendues (cases à cocher, « select all that apply », « choose two »…).\\n- \\\"lisible\\\" : faux si l'image ne contient pas de QCM, ou si l'énoncé ou un choix est coupé, flou ou masqué au point de ne pas pouvoir le recopier avec certitude. N'invente ni ne complète aucun mot.\\n- \\\"raison\\\" : si \\\"lisible\\\" est faux, ce qui manque ou gêne la lecture, en une phrase en français ; sinon chaîne vide.\"}]}]}) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "credentials": {
        "anthropicApi": {
          "id": "H830I5g8houaoPAf",
          "name": "Anthropic account"
        }
      }
    },
    {
      "id": "2739acf5-b66d-5f22-a001-6f4059954f93",
