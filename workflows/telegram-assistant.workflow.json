    {
      "id": "c4a1d9e0-0003-4b00-8000-000000000101",
      "name": "Build journal row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        500
      ],
      "parameters": {
        "jsCode": "// Why Code: une ligne de journal par message, quel que soit le chemin suivi (question, photo, PDF, erreur).\n// Sortie principale (0) = réponse ; sortie d'erreur (1) = échec du nœud.\nconst pick = (name) => {\n  if (!$(name).isExecuted) return null;\n  const ok = $(name).all(0);\n  if (ok.length) return { ok: true, j: ok[0].json };\n  return { ok: false, j: $(name).all(1)[0]?.json ?? {} };\n};\nconst type = $('Download document').isExecuted || $('Ask odoo-plan').isExecuted ? 'plan'\n  : $('Download photo').isExecuted ? 'qcm' : 'texte';\nconst steps = { plan: ['Download document', 'Ask odoo-plan'], qcm: ['Download photo', 'Ask odoo-qcm'], texte: ['Ask odoo-question'] }[type];\n// Dernière étape exécutée du chemin : la réponse, ou le nœud qui a échoué.\nconst r = steps.map(pick).filter(Boolean).find((x) => !x.ok) ?? pick(steps[steps.length - 1]) ?? { ok: false, j: {} };\nconst err = r.ok ? null : (r.j.error?.message ?? (typeof r.j.error === 'string' ? r.j.error : 'Erreur inconnue'));\nconst sentAt = $('Telegram Trigger').first().json.message.date * 1000;\nreturn [{\n  json: {\n    type,\n    duree_ms: Date.now() - sentAt,\n    cout_usd: r.ok ? (r.j.cout?.usd ?? null) : null,\n    statut: r.ok ? 'ok' : 'erreur',\n    erreur: err,\n    execution_id: String($execution.id),\n  },\n}];"
      }
    },
