    {
      "id": "5b2e7c41-1a9d-4e3f-8c6b-2d4f6a8c0e05",
      "name": "Format answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Why Code: mise en forme HTML Telegram (échappement, gras, statuts par élément, liens) et coupe à 4 096 caractères.\nconst r = $json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst fmt = (s) => esc(s).replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>');\nconst refs = (i) => (i.sources?.length ? ` <i>[${i.sources.join(', ')}]</i>` : '');\nconst mark = (i) => (i.statut === 'Documenté' ? '✅' : '⚠️');\nconst BADGE = { 'Documenté': '✅ Documenté', 'À vérifier': '⚠️ À vérifier', 'Non couvert': '❌ Non couvert' };\n\nconst lines = [`<b>${BADGE[r.statut] ?? esc(r.statut)}</b>`, '', `${mark(r.resume)} ${fmt(r.resume.texte)}${refs(r.resume)}`];\nif (r.prerequis.length) lines.push('', '<b>Prérequis</b>', ...r.prerequis.map((i) => `${mark(i)} ${fmt(i.texte)}${refs(i)}`));\nif (r.etapes.length) lines.push('', '<b>Étapes</b>', ...r.etapes.map((i, k) => `${k + 1}. ${mark(i)} <b>${fmt(i.titre)}</b> — ${fmt(i.texte)}${refs(i)}`));\nif (r.avertissements.length) lines.push('', '<b>Attention</b>', ...r.avertissements.map((i) => `${mark(i)} ${fmt(i.texte)}${refs(i)}`));\nif (r.pistes.length) lines.push('', '<b>Pistes à tester</b>', ...r.pistes.map((p) => `• ${fmt(p)}`));\nif (r.nonCouvert.length) lines.push('', '<b>Non couvert</b>', ...r.nonCouvert.map((p) => `• ${fmt(p)}`));\nif (r.sources.length) lines.push('', '<b>Sources — doc officielle Odoo 20</b>', ...r.sources.map((s) => `[${s.n}] <a href=\"${esc(s.url)}\">${esc(s.titre)}</a>`));\nlines.push('', `<i>✅ = vérifié sur la doc en ligne · ⚠️ = à vérifier · contrôle : ${esc(r.controle.site)} · ${Math.round(r.dureeMs / 1000)} s</i>`);\n\n// Coupe à une fin de ligne (chaque ligne ferme ses balises) ; découpage en plusieurs messages en Phase 4.\nlet text = lines.join('\\n');\nif (text.length > 4096) text = text.slice(0, text.lastIndexOf('\\n', 4000)) + '\\n\\n<i>… réponse tronquée</i>';\n\nreturn { json: { chatId: $('Telegram Trigger').first().json.message.chat.id, text } };\n"
      }
    },
