    {
      "id": "5b2e7c41-1a9d-4e3f-8c6b-2d4f6a8c0e05",
      "name": "Format answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "// Why Code: mise en forme HTML Telegram (échappement, gras, repères de source, liens) et découpage en messages de 4 096 caractères.\nconst r = $input.first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst fmt = (s) => esc(s).replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>');\nconst refs = (i) => (i.sources?.length ? ` <i>[${i.sources.join(', ')}]</i>` : '');\n// Repère seulement ce qui est confirmé ou d'une autre origine ; le reste s'affiche sans marque.\nconst MARK = { 'Documenté': '✅ ', 'Vidéo': '🎬 ', 'Web': '🌐 ' };\nconst mark = (i) => MARK[i.statut] ?? '';\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\n// Photo illisible (odoo-qcm) : demande d'une nouvelle photo, sans réponse.\nif (r.lisible === false) {\n  return [{ json: { chatId, text: `📷 ${esc(r.message)}\\n\\n<i>${esc(r.raison)}</i>` } }];\n}\n\nconst lines = [];\nif (r.lisible) {\n  // QCM (odoo-qcm) : question lue, choix avec la ou les bonnes réponses, explication, écart de version.\n  const letter = (k) => String.fromCharCode(65 + k);\n  lines.push('<b>Question lue</b>', esc(r.question_lue), '');\n  lines.push(...r.choix.map((c, k) => (r.bonnes_reponses.includes(letter(k)) ? `<b>${letter(k)}. ${esc(c)}</b> ✅` : `${letter(k)}. ${esc(c)}`)));\n  lines.push('', `<b>Réponse : ${r.bonnes_reponses.join(', ') || '?'}</b>`, `${mark(r.resume)}${fmt(r.explication)}${refs(r.resume)}`);\n  if (r.ecart_version) lines.push('', '<b>Différence avec Odoo 19</b>', fmt(r.ecart_version));\n} else {\n  lines.push(`${mark(r.resume)}${fmt(r.resume.texte)}${refs(r.resume)}`);\n  if (r.prerequis.length) lines.push('', '<b>Prérequis</b>', ...r.prerequis.map((i) => `• ${mark(i)}${fmt(i.texte)}${refs(i)}`));\n  if (r.etapes.length) lines.push('', '<b>Étapes</b>', ...r.etapes.map((i, k) => `${k + 1}. ${mark(i)}<b>${fmt(i.titre)}</b> — ${fmt(i.texte)}${refs(i)}`));\n}\nif (r.avertissements.length) lines.push('', '<b>Attention</b>', ...r.avertissements.map((i) => `• ${mark(i)}${fmt(i.texte)}${refs(i)}`));\nif (r.web?.length) lines.push('', '<b>Compléments web</b>', ...r.web.map((i) => `🌐 ${fmt(i.texte)}\\n${i.source.map((u) => `<a href=\"${esc(u)}\">${esc(u.replace(/^https?:\\/\\/(www\\.)?/, '').slice(0, 60))}</a>`).join(' · ')}`));\nif (r.nonCouvert.length) lines.push('', '<b>Absent de la doc Odoo</b>', ...r.nonCouvert.map((p) => `• ${fmt(p)}`));\nif (r.sources.length) lines.push('', '<b>Sources — doc officielle Odoo 20</b>', ...r.sources.map((s) => `[${s.n}] <a href=\"${esc(s.url)}\">${esc(s.titre)}</a>`));\nlines.push('', `<i>✅ confirmé sur la doc en ligne · 🎬 vidéo Odoo Tutorials · 🌐 web · ${Math.round(r.dureeMs / 1000)} s</i>`);\n\n// Découpage aux fins de ligne (chaque ligne ferme ses balises) ; une ligne seule trop longue part en texte brut.\nconst MAX = 4096;\nconst chunks = [];\nlet cur = '';\nfor (const line of lines.join('\\n').split('\\n')) {\n  const parts = line.length > MAX ? (line.replace(/<[^>]+>/g, '').match(new RegExp(`[^]{1,${MAX - 100}}`, 'g')) ?? []) : [line];\n  for (const p of parts) {\n    if (cur && cur.length + 1 + p.length > MAX) { chunks.push(cur); cur = p; } else cur = cur ? `${cur}\\n${p}` : p;\n  }\n}\nif (cur.trim()) chunks.push(cur);\nreturn chunks.filter((t) => t.trim()).map((text) => ({ json: { chatId, text } }));\n"
      }
    },
