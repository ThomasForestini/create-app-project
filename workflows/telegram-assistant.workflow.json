    {
      "id": "5b2e7c41-1a9d-4e3f-8c6b-2d4f6a8c0e05",
      "name": "Format answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Why Code: mise en forme HTML Telegram (échappement, gras, statuts par élément, liens) et coupe à 4 096 caractères.\nconst r = $json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst fmt = (s) => esc(s).replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>');\nconst refs = (i) => (i.sources?.length ? ` <i>[${i.sources.join(', ')}]</i>` : '');\nconst mark = (i) => (i.statut === 'Documenté' ? '✅' : '⚠️');\nconst BADGE = { 'Documenté': '✅ Documenté', 'À vérifier': '⚠️ À vérifier', 'Non couvert': '❌ Non couvert' };\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\n// Photo illisible (odoo-qcm) : demande d'une nouvelle photo, sans réponse.\nif (r.lisible === false) {\n  return { json: { chatId, text: `📷 ${esc(r.message)}\\n\\n<i>${esc(r.raison)}</i>` } };\n}\n\nconst lines = [`<b>${BADGE[r.statut] ?? esc(r.statut)}</b>`, ''];\nif (r.lisible) {\n  // QCM (odoo-qcm) : question lue, choix avec la ou les bonnes réponses, explication, écart de version.\n  const letter = (k) => String.fromCharCode(65 + k);\n  lines.push('<b>Question lue</b>', esc(r.question_lue), '');\n  lines.push(...r.choix.map((c, k) => (r.bonnes_reponses.includes(letter(k)) ? `<b>${letter(k)}. ${esc(c)}</b> ✅` : `${letter(k)}. ${esc(c)}`)));\n  lines.push('', `<b>Réponse : ${r.bonnes_reponses.join(', ') || '?'}</b>`, `${mark(r.resume)} ${fmt(r.explication)}${refs(r.resume)}`);\n  if (r.ecart_version) lines.push('', '<b>Écart v19 / v20</b>', `⚠️ ${fmt(r.ecart_version)}`);\n} else {\n  lines.push(`${mark(r.resume)} ${fmt(r.resume.texte)}${refs(r.resume)}`);\n  if (r.prerequis.length) lines.push('', '<b>Prérequis</b>', ...r.prerequis.map((i) => `${mark(i)} ${fmt(i.texte)}${refs(i)}`));\n  if (r.etapes.length) lines.push('', '<b>Étapes</b>', ...r.etapes.map((i, k) => `${k + 1}. ${mark(i)} <b>${fmt(i.titre)}</b> — ${fmt(i.texte)}${refs(i)}`));\n}\nif (r.avertissements.length) lines.push('', '<b>Attention</b>', ...r.avertissements.map((i) => `${mark(i)} ${fmt(i.texte)}${refs(i)}`));\nif (r.pistes.length) lines.push('', '<b>Pistes à tester</b>', ...r.pistes.map((p) => `• ${fmt(p)}`));\nif (r.nonCouvert.length) lines.push('', '<b>Non couvert</b>', ...r.nonCouvert.map((p) => `• ${fmt(p)}`));\nif (r.sources.length) lines.push('', '<b>Sources — doc officielle Odoo 20</b>', ...r.sources.map((s) => `[${s.n}] <a href=\"${esc(s.url)}\">${esc(s.titre)}</a>`));\nlines.push('', `<i>✅ = vérifié sur la doc en ligne · ⚠️ = à vérifier · contrôle : ${esc(r.controle.site)} · ${Math.round(r.dureeMs / 1000)} s</i>`);\n\n// Coupe à une fin de ligne (chaque ligne ferme ses balises) ; découpage en plusieurs messages en Phase 4.\nlet text = lines.join('\\n');\nif (text.length > 4096) text = text.slice(0, text.lastIndexOf('\\n', 4000)) + '\\n\\n<i>… réponse tronquée</i>';\n\nreturn { json: { chatId, text } };\n"
      }
    },
