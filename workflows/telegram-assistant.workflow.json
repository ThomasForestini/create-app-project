    {
      "id": "e1a0c3d4-0005-4b00-8000-000000000005",
      "name": "Format plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1860,
        400
      ],
      "parameters": {
        "jsCode": "// Why Code: résumé HTML Telegram du plan (besoins, étapes, questions ouvertes) découpé en messages de 4 096 caractères, et nom du fichier .md.\nconst r = $json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\nconst n = (k) => r.parStatut[k] ?? 0;\nconst statuts = [`✅ ${n('Documenté')} confirmées sur la doc`, n('Web') && `🌐 ${n('Web')} du web`, n('Vidéo') && `🎬 ${n('Vidéo')} des vidéos`].filter(Boolean).join(' · ');\nconst lines = [\n  `<b>📋 Plan Odoo 20 — ${esc(r.client)}</b>`,\n  `<i>Édition : ${esc(r.edition)}</i>`,\n  '',\n  '<b>Besoins compris</b>',\n  ...r.besoins.map((b) => `${b.n}. ${esc(b.titre)}`),\n  '',\n  `<b>Étapes (${r.etapes.length})</b> : ${statuts}`,\n  `<b>Tests</b> : ${r.tests.map((t) => esc(t.titre)).join(' ; ') || 'aucun'}`,\n];\nif (r.questions_ouvertes.length) lines.push('', `<b>Questions ouvertes (${r.questions_ouvertes.length})</b>`, ...r.questions_ouvertes.map((q) => `• ${esc(q.question)}`));\nlines.push('', `<i>Plan complet dans le fichier joint · ${r.cout.usd === null ? 'coût inconnu' : `${r.cout.usd.toFixed(3)} USD`} · ${Math.round(r.dureeMs / 1000)} s</i>`);\n\n// Découpage aux fins de ligne (chaque ligne ferme ses balises), un message par partie.\nconst texts = [];\nfor (const line of lines) {\n  if (texts.length && texts[texts.length - 1].length + 1 + line.length <= 4096) texts[texts.length - 1] += `\\n${line}`;\n  else texts.push(line.slice(0, 4096));\n}\n\nconst slug = String(r.client || 'client').normalize('NFD').replace(/\\p{Diacritic}/gu, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'client';\nreturn { json: { chatId, texts, markdown: r.markdown, fileName: `plan-${slug}.md` } };\n"
      }
    },
